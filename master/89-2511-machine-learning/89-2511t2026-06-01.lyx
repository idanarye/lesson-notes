\begin_layout Standard
בשביל שהמשקלים יהיו קטנים,
 מוסיפים ל
\lang english
loss
\lang hebrew
:
\begin_inset Formula 
\[
L_{\textnormal{new}}\left(W\right)=L_{\textnormal{original}\left(W\right)+\frac{\lambda}{2}\left\Vert W\right\Vert ^{2}_{2}}
\]

\end_inset

זה מתבטא כשיורדים בגרדיאנט:
\begin_inset Formula 
\[
W^{t}=\underbrace{\left(1-\eta\lambda\right)W^{t-1}}_{\textnormal{Weight Decay}}-\underbrace{\eta\left(\frac{\partial L_{\textnormal{original}}}{\partial W}\right)}_{\textnormal{Usual GD}}
\]

\end_inset


\end_layout

