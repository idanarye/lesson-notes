\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset

נבנה את 
\begin_inset Formula $A_{B}$
\end_inset

 אוטומט בוקי
\begin_inset Formula 
\[
A_{B}=\left(\Sigma,Q_{B},q^{M}_{0},\delta_{B},\textnormal{Büchi}\left(F_{B}\right)\right)
\]

\end_inset

באופן הבא:
\begin_inset Formula 
\[
Q_{B}=Q_{M}\cup\bigcup_{i=1,\dots n}\left(\left\{ i\right\} \times\underbrace{F_{i}}_{\textnormal{Progress}}\times\underbrace{F_{i}}_{\textnormal{Memory}}\right)
\]

\end_inset


\begin_inset Formula 
\begin{align*}
\delta_{B}= & \underbrace{\delta_{M}}_{\textnormal{for \ensuremath{Q_{M}}}}\cup\left\{ \underbrace{\left(q,\sigma,\left(i,q',q'\right)\right)}_{\textnormal{Transitioning from \ensuremath{Q_{M}} to \ensuremath{F_{i}}}}\middle|\begin{array}{c}
i=1,\dots n\\
\left(q,\sigma,q'\right)\in\delta_{M}\\
q'\in F_{i}
\end{array}\right\} \\
 & \cup\left\{ \left(\left(i,p,q\right),\sigma,\left(i,p',q'\right)\right)\middle|\begin{array}{c}
p,p',q,q'\in F_{i}\\
\left(p,\sigma,q'\right)\in\delta_{M}\\
q'=\begin{cases}
q & p\neq q\\
q^{i}_{j+1} & p=q=q^{i}_{j}\\
q^{i}_{1} & p=q=q^{i}_{k_{i}}
\end{cases}
\end{array}\right\} 
\end{align*}

\end_inset


\begin_inset Formula 
\[
F_{B}=\bigcup_{i=1,\dots n}\left\{ i\right\} \times\left\{ q^{i}_{1}\right\} \times\left\{ q^{i}_{1}\right\} 
\]

\end_inset


\end_layout

