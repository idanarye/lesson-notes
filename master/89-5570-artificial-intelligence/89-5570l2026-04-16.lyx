Set Cover
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
תזכורת:
 בהינתן קבוצה 
\begin_inset Formula $U$
\end_inset

 ואוסף תתי קבוצות 
\begin_inset Formula $C=\left\{ C_{1},\dots,C_{n}\right\} $
\end_inset

 כאשר 
\begin_inset Formula $\forall_{i}C_{i}\subseteq U$
\end_inset

 ומספר טבעי 
\begin_inset Formula $K\in\mathbb{N}$
\end_inset

,
 האם קיים 
\begin_inset Formula $S=\left\{ S_{1},\dots,S_{m}\right\} \subseteq C$
\end_inset

 עבורו 
\begin_inset Formula $S_{1}\cup\cdots\cup S_{m}=U$
\end_inset

 ו
\begin_inset Formula $m\le K$
\end_inset

.
\end_layout

