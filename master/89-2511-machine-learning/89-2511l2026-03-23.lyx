\begin_inset Formula 
\[
P\left(\omega_{j}\middle|x\right)=P\left(x\middle|w_{j}\right)\frac{P\left(\omega_{j}\right)}{P\left(x\right)}=P\left(x\middle|\omega_{j}\right)\frac{P\left(\omega_{j}\right)}{\sum_{k}P\left(x\middle|\omega_{k}\right)P\left(\omega_{k}\right)}
\]

\end_inset


