\begin_layout Subsection*
מה קורה כשיש הרבה תצפיות?
\end_layout

\begin_layout Standard
נכליל את הדוגמה למצב שיש הרבה תצפיות 
\begin_inset Formula $x_{1},\dots x_{n}$
\end_inset

:
\begin_inset Formula 
\[
\underset{\textnormal{Likelihood ratio}}{\underbrace{\frac{P\left(x_{1},\dots x_{n}\middle|\omega_{1}\right)}{P\left(x_{1},\dots x_{n}\middle|\omega_{2}\right)}}}>\underset{\textnormal{Decision boundary}}{\underbrace{\frac{P\left(\omega_{2}\right)}{P\left(\omega_{1}\right)}\cdot\frac{\lambda_{12}-\lambda_{22}}{\lambda_{21}-\lambda_{11}}=\Theta}}
\]

\end_inset


\end_layout

\begin_layout Standard
אם נניח שהתצפיות בלתי תלויות ושוות התפלגות בהינתן מצב העולם 
\begin_inset Formula $\omega$
\end_inset

 (
\lang english
i.i.d
\family roman
\series medium
\shape up
\size normal
\emph off
\nospellcheck off
\bar no
\strikeout off
\xout off
\uuline off
\uwave off
\noun off
\color none
\lang hebrew
):
\begin_inset Formula 
\[
\frac{\prod_{i}P\left(x_{i}\middle|\omega_{1}\right)}{\prod_{i}P\left(x_{i}\middle|\omega_{2}\right)}>\Theta
\]

\end_inset

מבחינה נומרית,
 כאשר מכפילים מספר גדול של הסתברויות עלולים להיתקל בבעיות של ייצוג מספרים קטנים.
 לכן נגדיר 
\begin_inset Formula $\Theta'=\log\Theta$
\end_inset

 ונעשה:
\begin_inset Formula 
\[
\sum_{i}\log\frac{P\left(x_{i}\middle|\omega_{1}\right)}{P\left(x_{i}\middle|\omega_{2}\right)}>\Theta'
\]

\end_inset

