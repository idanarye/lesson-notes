\begin_layout Standard
מטריצת המחירים היא 
\begin_inset Formula $2\times2$
\end_inset

 שנסמן 
\begin_inset Formula $\lambda_{k,j}=\lambda\left(\alpha_{k}\middle|\omega_{j}\right)$
\end_inset

.
 המחיר לכל פעולה הוא:
\begin_inset Formula 
\[
R\left(\alpha_{1}\middle|x\right)=\lambda_{11}P\left(\omega_{1}\middle|x\right)+\lambda_{12}P\left(\omega_{2}\middle|x\right)
\]

\end_inset


\begin_inset Formula 
\[
R\left(\alpha_{2}\middle|x\right)=\lambda_{21}P\left(\omega_{1}\middle|x\right)+\lambda_{22}P\left(\omega_{2}\middle|x\right)
\]

\end_inset

אנחנו רוצים לבחור את 
\begin_inset Formula $\alpha_{1}$
\end_inset

 אם הסיכון שלה קטן מ
\begin_inset Formula $\alpha_{2}$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lambda_{11}P\left(\omega_{1}\middle|x\right)+\lambda_{12}P\left(\omega_{2}\middle|x\right)<\lambda_{21}P\left(\omega_{1}\middle|x\right)+\lambda_{22}P\left(\omega_{2}\middle|x\right)
\]

\end_inset


\begin_inset Formula 
\[
\left(\lambda_{12}-\lambda_{22}\right)P\left(\omega_{2}\middle|x\right)<\left(\lambda_{21}-\lambda_{11}\right)P\left(\omega_{1}\middle|x\right)
\]

\end_inset


\begin_inset Formula 
\[
\frac{P\left(\omega_{1}\middle|x\right)}{P\left(\omega_{2}\middle|x\right)}>\frac{\lambda_{12}-\lambda_{22}}{\lambda_{21}-\lambda_{11}}
\]

\end_inset

ונפעיל את חוק בייס:
\begin_inset Formula 
\[
\underset{\textnormal{Likelihood ratio}}{\underbrace{\frac{P\left(x\middle|\omega_{1}\right)}{P\left(x\middle|\omega_{2}\right)}}}>\underset{\textnormal{Decision boundary}}{\underbrace{\frac{P\left(\omega_{2}\right)}{P\left(\omega_{1}\right)}\cdot\frac{\lambda_{12}-\lambda_{22}}{\lambda_{21}-\lambda_{11}}}}
\]

\end_inset

