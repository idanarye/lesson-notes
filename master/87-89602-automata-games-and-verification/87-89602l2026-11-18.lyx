 - כלומר אוסף של תתי קבוצות של המצבים.
 נסמן 
\begin_inset Formula $\mathcal{F}=\left\{ F_{1},\dots F_{n}\right\} $
\end_inset

.
\begin_inset Formula 
\[
\textnormal{Muller}\left(\mathcal{F}\right)=\left\{ \alpha\middle|\begin{array}{c}
\textnormal{There is a run \ensuremath{r} of \ensuremath{A} on such that}\\
\inf\left(r\right)\in\mathcal{F}
\end{array}\right\} 
\]

\end_inset


\begin_inset Formula 
\[
\left\{ F_{1},\dots F_{n}\right\} =\left\{ \alpha\middle|\inf\left(r\right)=F_{i}\textnormal{ for \ensuremath{i=1,\dots n}}\right\} 
\]

\end_inset


\end_layout

