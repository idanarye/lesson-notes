\begin_layout Standard
כשמריצים את הפוליסה,
 נתחיל עם באפר 
\begin_inset Formula $\mathcal{B}$
\end_inset

 בגודל 
\begin_inset Formula $\mathcal{D}$
\end_inset

,
 ונשתמש בפוליסה 
\begin_inset Formula $\pi$
\end_inset

 במשך 
\begin_inset Formula $\mathcal{D}$
\end_inset

 צעדים כאשר בכל צעד 
\begin_inset Formula $i$
\end_inset

:
\begin_inset Formula 
\[
\mathcal{B}\left[i\right]=\left(s_{i},a_{i}=\pi\left(s_{i}\right),r_{i+1},s_{i+1}\right)
\]

\end_inset

ואז השערוך של פונקציית המעברים הוא:
\begin_inset Formula 
\[
\hat{P}\left(s'\middle|s,\pi\left(s\right)\right)=\frac{\textnormal{\#times we saw }s\to s'}{\textnormal{\#times we left }s}
\]

\end_inset

ושערוך פונקציית התגמול הוא:
\begin_inset Formula 
\[
\hat{R}\left(s\right)=\textnormal{average reward we got when reaching state }s
\]

\end_inset

את שערוך הפוליסה מעדכנים בכל צעד:
\begin_inset Formula 
\[
V^{\pi}\left(s\right)\gets\hat{R}\left(s\right)+\gamma\sum_{s'}\hat{P}\left(s'\middle|s,\pi\left(s\right)\right)V^{\pi}\left(s'\right)
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
נשים
\begin_inset space ~
\end_inset

לב:
 
\begin_inset Formula $V^{\pi}$
\end_inset

 הוא הערך אם נרוץ אינסוף פעמים - ולכן 
\begin_inset Formula $\gamma$
\end_inset

 גורם לו להתכנס:
\begin_inset Formula 
\[
G=R\left(1+\gamma+\gamma^{2}+\cdots\right)=\frac{R}{1-\gamma}
\]

\end_inset


\end_layout

