\begin_layout Itemize
פעולות אפשריות:
 
\begin_inset Formula $A=\left\{ \alpha_{1},\dots,\alpha_{k}\right\} $
\end_inset


\end_layout

\begin_layout Itemize
עלויות:
 
\begin_inset Formula $\Lambda=\left\{ \lambda\left(\alpha_{k}\middle|\omega_{j}\right)\right\} $
\end_inset


\end_layout

\begin_layout Standard
אנחנו רוצים לבחור את הפעולה בהינתן התצפיות.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P\left(\omega\middle|x\right)=\frac{P\left(x\middle|\omega\right)}{P\left(x\right)}P\left(\omega\right)
\]

\end_inset


\end_layout

\begin_layout Section*
סיכון מותנה
\end_layout

\begin_layout Standard
הסיכון המותנה הוא תוחלת העלות של פעולה 
\begin_inset Formula $\alpha_{k}$
\end_inset

 בהינתן תצפית 
\begin_inset Formula $x_{i}$
\end_inset

:
\begin_inset Formula 
\[
R\left(\alpha_{k}\middle|x_{i}\right)=\sum_{\omega_{j}\in\Omega}\lambda\left(\alpha_{k},\omega_{k}\right)\cdot P\left(\omega_{j}\middle|x_{i}\right)=\mathbb{E}_{P\left(\omega_{j}\middle|x_{i}\right)}\left[\lambda\left(\alpha_{k}\middle|\omega_{j}\right)\right]
\]

\end_inset

העלות של אסטרטציה 
\begin_inset Formula $\alpha\left(S_{n}\right)$
\end_inset

 היא:
\begin_inset Formula 
\[
R\left(\alpha\left(S_{n}\right)\right)=\sum_{x_{i}\in S_{n}}R\left(\alpha\left(x_{i}\right)\middle|x_{i}\right)\cdot P\left(x_{i}\right)=\mathbb{E}_{P\left(x_{i}\right)}\left[R\left(\alpha\left(x_{i}\right)\right)\middle|x_{i}\right]
\]

\end_inset


\end_layout

