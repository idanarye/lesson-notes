\begin_inset Formula $X_{d}$
\end_inset

 הוא משתנה מקרי רב ממדי
\end_layout

\end_deeper
\begin_layout Labeling
\labelwidthstring 00.00.0000
הגדרה שונות משותפת של זוג משתנים (משתנה מקרי דו ממדי) היא:
\begin_inset Formula 
\[
Cov\left(X,Y\right)=E\left(X\cdot Y\right)-E\left(X\right)E\left(Y\right)
\]

\end_inset

 נסמן 
\begin_inset Formula $\mu_{X}=E\left(X\right)$
\end_inset

 ו
\begin_inset Formula $\mu_{Y}=E\left(Y\right)$
\end_inset

,
 ונוכל לכתוב
\begin_inset Formula 
\[
Cov\left(X,Y\right)=E\left[\left(X-\mu_{X}\right)\cdot E\left(Y-\mu_{Y}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
מטריצת השונות היא:
\begin_inset Formula 
\[
\left[\begin{array}{cc}
Cov\left(X,X\right) & Cov\left(X,Y\right)\\
Cov\left(Y,X\right) & Cov\left(Y,X\right)
\end{array}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
והבכללה ל
\begin_inset Formula $d$
\end_inset

 מימדים:
\begin_inset Formula 
\[
Cov\left(X\right)=\left(\begin{array}{ccc}
Cov\left(X_{1},X_{1}\right) & \cdots & Cov\left(X_{1},X_{d}\right)\\
\vdots & \ddots & \vdots\\
Cov\left(X_{d},X_{1}\right) & \cdots & Cov\left(X_{d},X_{d}\right)
\end{array}\right)
\]

\end_inset

נשים לב שהערכים על האלכסון הם השונויות של הרכיבים.
\end_layout

\begin_layout Standard
אפשר לייצג את זה בצורה יותר קומפקטית באמצעות ווקטורים.
 יהי 
\begin_inset Formula $\mu=E\left[X\right]=\left(\mu_{1},\dots,\mu_{d}\right)^{T}$
\end_inset

,
 אזי:
\begin_inset Formula 
\[
\Sigma=E\left[\left(X-\mu\right)\left(X-\mu\right)^{T}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
מכיוון שכל אחת מהשונויות המשותפות היא סימטרית,
 המטריצה כולה היא סימטרית - ולכן הווקטורים העצמיים שלה אורתוגונליים.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
טענה מטריצת השונות היא חיובית.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
הוכחה 
\begin_inset ERT
status open

\begin_layout Plain Layout

\end_layout

\end_inset

תהי 
\begin_inset Formula $\Sigma$
\end_inset

 מטריצת שונות משותפת ורוצים להוכיח שהיא חיובית - כלומר לכל 
\begin_inset Formula $z\in\mathbb{R}^{d}$
\end_inset

 מתקיים 
\begin_inset Formula $z^{T}\Sigma z\ge0$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Standard
נתחיל מצד שמאל:
\begin_inset Formula 
\[
z^{T}\Sigma z=z^{T}E\left[\left(X-\mu\right)\left(X-\mu\right)^{T}\right]z
\]

\end_inset

נכניס את הווקטורים לתוחלת:
\begin_inset Formula 
\[
z^{T}\Sigma z=E\left[x^{T}\left(X-\mu\right)\left(X-\mu\right)^{T}z\right]
\]

\end_inset

מכיוון ש
\begin_inset Formula $zT\left(X-\mu\right)$
\end_inset

 הוא סקלר:
\begin_inset Formula 
\[
z^{T}\Sigma z=E\left[z^{T}\left(X-\mu\right)\left(\left(X-\mu\right)^{T}z\right)\right]
\]

\end_inset

מכיוון ש
\begin_inset Formula $\left(X-\mu\right)^{T}z=\left(z^{T}\left(X-\mu\right)\right)^{T}$
\end_inset

 (שחלוף של סקלר הוא הסקלר עצמו) אפשר לכתוב:
\begin_inset Formula 
\[
z^{T}\Sigma z=E\left[\left(z^{T}\left(X-\mu\right)\right)\left(z^{T}\left(X-\mu\right)\right)^{T}\right]
\]

\end_inset


\begin_inset Formula 
\[
z^{T}\Sigma z=E\left[\left(z^{T}\left(X-\mu\right)\right)^{2}\right]
\]

\end_inset

ולכן הערכים העצמיים חיוביים - ומכיוון שהמטריצה סימטרית,
 היא חיובית.
\end_layout

\end_deeper
\begin_layout Section*
התפלגות נורמלית (
\lang english
Gaussian
\lang hebrew
) רב מימדית
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
תזכורת:
 בהתפלגות נורמלית רגילה 
\begin_inset Formula $X\sim N\left(\mu,\sigma^{2}\right)$
\end_inset

 פונקציית הצפיפות היא:
\begin_inset Formula 
\[
f\left(x\right)=\frac{1}{\sigma\sqrt{2\pi}}e^{-\frac{1}{2}\left(\frac{x-\mu}{\sigma}\right)^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
בהתפלגות נורמלית רב מימדית 
\begin_inset Formula $X\sim N\left(\mu,\Sigma\right)$
\end_inset

 פונקציית הצפיפות היא:
\begin_inset Formula 
\[
f\left(x\right)=\frac{1}{\left(2\pi\right)^{\frac{d}{2}}\left|\Sigma\right|^{\frac{1}{2}}}\exp\left(-\frac{1}{2}\left(x-\mu\right)^{T}\Sigma^{-1}\left(x-\mu\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
זה נראה כמו פעמון 
\begin_inset Formula $d$
\end_inset

-ממדי,
 כאשר הההתפלגות השולית על כל משתנה
\begin_inset Foot
status open

\begin_layout Plain Layout
כלומר ההתפלגות שלו כאשר מתעלמים מהמשתנים האחרים
\end_layout

\end_inset

 היא התפלגות גאוסיאנית חד ממדית (פעמון חד ממדי)
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
תזכורת משמעות הפרמטרים:
\end_layout

\begin_deeper
\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\mu$
\end_inset

 התוחלת - מזיזה את כל ההתפלגות.
 קובעת את מרכז ההתפלגות.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\sigma$
\end_inset

 השונות - הפיזור סביב האפס.
 ככל שהיא יותר גדולה,
 הפעמון יותר נמוך.
\end_layout

\end_deeper
\begin_layout Standard
במקרה הרב ממדי,
 התוחלת 
\begin_inset Formula $\mu$
\end_inset

 עדיין קובעת את המרכז.
 אבל הסיפור של השונות קצת יותר מורכב כי יש לנו מטריצה של שונות משותפת.
 במקרה הדו מימדי (
\lang english
bivariate Gaussian
\lang hebrew
) צורת הפעמון,
 בהסתכלות מלמעלה,
 הוא אליפסה:
\end_layout

\begin_layout Itemize
עבור 
\begin_inset Formula $\Sigma=I$
\end_inset

 האליפסה היא בעצם עיגול.
\end_layout

\begin_layout Itemize
עבור שונות משותפת שהיא מטריצה אלכסונית
\begin_inset Foot
status open

\begin_layout Plain Layout
יש ערכים על האלכסון,
 אבל כל שאר הערכים הם אפס.
\end_layout

\end_inset

 - למשל 
\begin_inset Formula $\Sigma=\text{diag}\left(1,2\right)$
\end_inset

 - האליפסה מיושרת לצירים.
 ההתפלגות המשותפת שווה למכפלת ההתפלגויות השוליות.
\end_layout

\begin_layout Itemize
אבל אם יש שונות משותפת שונה מאפס לשני המשתנים,
 האליפסה 
\begin_inset Quotes eld
\end_inset

מוטה
\begin_inset Quotes erd
\end_inset

.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
תכונות תהי 
\begin_inset Formula $X=\left(X_{1},\dots,X_{d}\right)^{T}$
\end_inset

 התפלגות גאוסיאנית
\end_layout

\begin_deeper
\begin_layout Itemize
כל חתך 
\begin_inset Formula $\left(X_{1},\dots,X_{i-1,},X_{i+1},\dots X_{d}\right)|X_{i}$
\end_inset

 גם הוא גאוסיאני (ממימד 
\begin_inset Formula $d-1$
\end_inset

)
\end_layout

\begin_layout Itemize
החתך 
\begin_inset Formula $\int^{\infty}_{-\infty}f_{X}\left(x_{1},x_{2},\dots,x_{d}\right)\mathrm{\,d}x_{1}$
\end_inset

 גם הוא גאוסיאני (ממימד 
\begin_inset Formula $d-1$
\end_inset

)
\end_layout

\end_deeper
\begin_layout Section*
נגזרות במרחבים רב מימדיים
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
הגדרה גרדיאנט.
 תהיה פונקציה 
\begin_inset Formula $f\left(x_{1},\dots x_{d}\right):\mathbb{R}^{d}\to\mathbb{R}$
\end_inset

,
 ווקטור 
\begin_inset Formula $x=\left[x_{1},\dots x_{d}\right]$
\end_inset

.
 הגרדיאנט הוא ווקטור הנגזרות ביחס לכל אחד מהמשתנים:
\begin_inset Formula 
\[
\nabla f\left(x\right)=\left[\frac{\partial f}{\partial x_{1}},\dots\frac{\partial f}{\partial x_{d}}\right]
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
תכונה הגרדיאנט מצביע על הכיוון עם השיפוע החד ביותר
\begin_inset Foot
status open

\begin_layout Plain Layout
הגרדיאנט מצביע על כיוון העליה - והכיוון ההפוך הוא כיוון הירידה
\end_layout

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
הוכחה נסמן 
\begin_inset Formula $D_{u}\left(f\left(x\right)\right)$
\end_inset

 - כמה הפונגציה משתנה בכיוון 
\begin_inset Formula $u$
\end_inset

 (נניח ש
\begin_inset Formula $f$
\end_inset

 גזירה בכל כיוון):
\begin_inset Formula 
\[
D_{u}\left(f\left(x\right)\right)=\lim\nolimits_{h\to0}\frac{f\left(x+hu\right)-f\left(x\right)}{h}
\]

\end_inset

נכתוב את 
\begin_inset Formula $f$
\end_inset

 ע
\begin_inset Quotes erd
\end_inset

י טור טיילור:
\begin_inset Formula 
\[
f\left(x+hu\right)\approx f\left(x\right)+\nabla f\left(x\right)hu+\epsilon\left(h\right)
\]

\end_inset

אזי:
\begin_inset Formula 
\[
D_{u}\left(f\left(x\right)\right)=\lim_{h\to0}\frac{f\left(x\right)+\nabla f\left(x\right)hu+\epsilon\left(h\right)-f\left(x\right)}{h}=\nabla f\left(x\right)u
\]

\end_inset

נשתמש באי שוויון קושי 
\begin_inset Formula $\left\Vert ab\right\Vert \le\left\Vert a\right\Vert \left\Vert b\right\Vert $
\end_inset

 ו
\begin_inset Formula $\left\Vert u\right\Vert =1$
\end_inset

:
\begin_inset Formula 
\[
\left|D_{u}\left(f\left(x\right)\right)\right|=\left\Vert \nabla f\left(x\right)u\right\Vert \le\left\Vert \nabla f\left(x\right)\right\Vert 
\]

\end_inset

וזה הכי גדול כאשר שני הווקטורים קו-לינארים - כלומר נקבל ערך מקסימלי בכיוון של הגרדיאנט.
\end_layout

\begin_layout Standard
למה זה חשוב?
 כי אם יש לנו פונקציה מאוד מורכבת,
 אם נעשה צעדים במורד הגרדיאנט נוכל די מהר להגיע למינימום מקומי.
\end_layout

