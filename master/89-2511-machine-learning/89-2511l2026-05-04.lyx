בהתאם למודל:
\begin_inset Formula 
\[
P\left(y=1\middle|x\right)=\sigma\left(w^{T}x\right)\qquad P\left(y=0\middle|x\right)=1-\sigma\left(w^{T}x\right)
\]

\end_inset

ועבור כל ה
\lang english
training data
\lang hebrew
:
\begin_inset Formula 
\[
\mathcal{L}\left(w\right)=\prod_{y_{i}=1}P\left(y=1\middle|x_{i}\right)\prod_{y_{i}=0}P\left(y=0\middle|x_{i}\right)
\]

\end_inset

שזה יוצא
\begin_inset Formula 
\[
\mathcal{L}\left(w\right)=\prod_{i=1\dots n}\sigma\left(w^{T}x_{i}\right)^{y_{i}}\prod_{i=1,\dots n}\left(1-\sigma\left(w^{T}x_{i}\right)\right)^{1-y_{i}}
\]

\end_inset

ומוציאים 
\begin_inset Formula $\log$
\end_inset

 כדי להפוך את זה לסכום:
\begin_inset Formula 
\[
\log\mathcal{L}=\sum_{i}y_{i}\log\left[\sigma\left(w^{T}\left(y=0\middle|x_{i}\right)\right)\right]+\sum_{i}\left(1-y_{i}\right)\log\left[1-\sigma\left(w^{T}\left(y=0\middle|x_{i}\right)\right)\right]
\]

\end_inset

אנחנו רוצים למצוא מינימום,
 לא מקסימום,
 לכן נכפיל ב
\begin_inset Formula $-1$
\end_inset

.
 נחשב את הגרדיאנט של השגיאה ונמצא שהוא
\begin_inset Formula 
\[
\nabla Err=\frac{1}{2}\sum_{i}x_{i}\left[y_{i}-\hat{y}_{i}\right]
\]

\end_inset

וכלל העדכון:
\begin_inset Formula 
\[
w_{t+1}=w_{t}-\eta\sum^{n}_{i=1}x_{i}\left[\sigma\left(w^{T}_{t}x_{i}\right)-y_{i}\right]
\]

\end_inset


\end_layout

