\begin_layout Standard
\begin_inset Formula $V_{\pi}\left(s\right)$
\end_inset

 הוא הערך שתיתן לנו מדיניות 
\begin_inset Formula $\pi$
\end_inset

 באשר אנחנו במצב 
\begin_inset Formula $s$
\end_inset

.
 זה תלוי בתגמול המיידי - אבל גם איפה ש
\begin_inset Formula $\pi$
\end_inset

 לוקח אותנו בהמשך ומה נוכל להשיג שם.
\end_layout

\begin_layout Subsection*
במקרה של אופק סופי
\end_layout

\begin_layout Standard
\begin_inset Formula $V^{k}_{\pi}\left(s\right)$
\end_inset

 הוא התוחלת המותנית
\begin_inset Formula 
\[
V^{k}_{\pi}\left(s\right)=\mathbb{E}\left[\sum^{k}_{t=0}R_{t}\middle|\pi,s\right]=\mathbb{E}\left[\sum^{k}_{t=0}R\left(s_{t}\right)\middle|a_{t}=\pi\left(s_{t},k-t\right),s_{0}=s\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*
חישוביות
\end_layout

\begin_layout Standard
בשביל לחשב את זה בד
\begin_inset Quotes erd
\end_inset

כ לא נחשב את הכל,
 אלא נעשה מונט-קרלו - כלומר נגריל כמה אפשרויות להרצת הפוליסה ונעשה ממוצע.
\end_layout

\begin_layout Standard
אפשר להתייחס ל
\begin_inset Formula $V^{t}_{\pi}$
\end_inset

 בתור ווקטור 
\begin_inset Formula $V^{t}_{\pi}=\left[\begin{matrix}V^{t}_{\pi}\left(s_{1}\right)\\
\vdots\\
V^{t}_{\pi}\left(s_{n}\right)
\end{matrix}\right]$
\end_inset


\end_layout

\begin_layout Standard
כמות הפוליסות האפשריות היא 
\begin_inset Formula $\left|A\right|^{H_{n}}$
\end_inset

 (כאשר 
\begin_inset Formula $H$
\end_inset

 הוא האופק)
\end_layout

\begin_layout Standard
בשביל לחשב נשתמש בתכנות דינמי.
 לכל 
\begin_inset Formula $s\in S$
\end_inset

 נמצא:
\begin_inset Formula 
\[
V^{0}_{\pi}\left(s\right)=R\left(s\right)
\]

\end_inset


\begin_inset Formula 
\[
V^{t}_{\pi}\left(s\right)=R\left(s\right)+\sum_{s'}P\left(s'\middle|s,\pi\left(s,t\right)\right)\cdot V^{t-1}_{\pi}\left(s'\right)
\]

\end_inset

ואפשר,
 באמצעות כפל מטריצות,
 לחשב:
\begin_inset Formula 
\[
V^{t}_{\pi}=R+T_{\pi}\cdot V^{t-1}_{\pi}
\]

\end_inset

כאשר 
\begin_inset Formula $T_{\pi}$
\end_inset

 היא מטריצת המעברים לפי 
\begin_inset Formula $\pi$
\end_inset

 - עבור כל מצב 
\begin_inset Formula $s$
\end_inset

,
 מה ההסתברות להגיע לכל מצב אחר כאשר מבצעים 
\begin_inset Formula $\pi\left(s\right)$
\end_inset

.
\end_layout

\begin_layout Standard
בכל צעד (מהסוף) מסתכלים על תוחלת התגמול לכל פעולה אפשרית 
\begin_inset Formula $Q^{t}_{\pi}\left(s,a\right)$
\end_inset

 ובוחרים את הפעולה הכי טובה.
\end_layout

\begin_layout Standard
החישוב הזה הוא פולינומי:
 
\begin_inset Formula $\left|S\right|\times\left|H\right|\times\left|A\right|$
\end_inset


\end_layout

\begin_layout Standard
הפוליסה האופטימלית מסומנת ב
\begin_inset Formula $\pi^{*}$
\end_inset

,
 ו
\begin_inset Formula $\forall_{s\in S}$
\end_inset

:
\begin_inset Formula 
\[
V^{0}_{\pi^{*}}\left(s\right)=R\left(s\right)
\]

\end_inset


\begin_inset Formula 
\[
V^{t}_{\pi^{*}}\left(s\right)=R\left(s\right)+\max_{a}\sum_{s'}P\left(s'\middle|s,a\right)\cdot V^{t-1}_{\pi^{*}}\left(s'\right)
\]

\end_inset


